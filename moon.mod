name = "moonbitstack/moonpsec"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonpsec"

license = "Apache-2.0"

keywords = [
  "parser",
  "parsers",
  "parser-combinator",
  "parsec",
  "megaparsec",
  "fparsec",
  "grammar",
  "recursive-descent",
  "combinator",
  "lexer",
  "tokenizer",
  "streaming",
  "incremental",
  "backtracking",
  "precedence",
  "expression",
  "error-message",
  "diagnostic",
  "peg",
  "bnf",
  "ebnf",
  "json",
  "moonbit",
]

description = "Parser combinators for MoonBit: small parsers assembled into a grammar, with line and column errors, merged expected sets, explicit backtracking, operator tables and incremental input."

source = "src"
